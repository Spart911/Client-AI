# Optional one-shot (not installed by install.sh). Same paths as voice-bt-connect.
[Unit]
Description=One-shot Bluetooth speaker connect for voice-client-pi
After=bluetooth.target sound.target
Wants=bluetooth.target

[Service]
Type=oneshot
WorkingDirectory=%h/voice-client-pi
Environment=ENV_FILE=%h/voice-client-pi/.env
Environment=BT_CONNECT_ONCE=true
ExecStart=%h/voice-client-pi/scripts/bt-connect.sh
