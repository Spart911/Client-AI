[Unit]
Description=Auto-connect Bluetooth speaker for voice-client-pi
After=bluetooth.target network.target sound.target
Wants=bluetooth.target

[Service]
Type=simple
WorkingDirectory=%h/Client-AI
Environment=ENV_FILE=%h/Client-AI/.env
Environment=BT_CONNECT_ONCE=false
ExecStart=%h/Client-AI/scripts/bt-connect.sh
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
