VOICE_BACKEND_URL=http://voice.pora-ai.ru
MUSIC_DEVICE_ID=pi-livingroom
OWW_MODEL=alexa
OWW_THRESHOLD=0.5
# Pi 3B 32-bit (armv7): tflite — onnxruntime wheels are missing there
OWW_FRAMEWORK=tflite
# OWW_VAD_THRESHOLD must stay 0 on Pi 3B 32-bit (Silero VAD needs real onnxruntime)
# OWW_VAD_THRESHOLD=0.5
MUSIC_POLL=true
# Bluetooth speaker (auto-connect via scripts/bt-connect.sh)
# Find MAC: bluetoothctl devices
# BT_DEVICE_MAC=AA:BB:CC:DD:EE:FF
# handsfree_head_unit = speaker + mic; a2dp_sink = speaker only
BT_PROFILE=handsfree_head_unit
# BT_CONNECT_INTERVAL=15
# SILENCE_SEC=1.8
# WAKE_ENERGY=0.01
# BARGE_IN=true
# MPV_COMMAND=mpv
# Prefer Pulse default (Bluetooth after pactl set-default-source/sink)
AUDIO_INPUT_DEVICE=pulse
# HFP mics are quiet — lower if wake never triggers
WAKE_ENERGY=0.002
# OWW_THRESHOLD=0.35
# For Bluetooth speaker+mic: host Pulse must be running, and card profile
# handsfree_head_unit (HFP) — A2DP alone has no microphone.
