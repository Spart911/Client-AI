VOICE_BACKEND_URL=http://voice.pora-ai.ru
MUSIC_DEVICE_ID=pi-livingroom

# microWakeWord «Джарвис»
MWW_MODEL_CONFIG=/app/models/ru_jarvis_mww.json
WAKE_THRESHOLD=0.90
WAKE_STABLE_FRAMES=3
WAKE_ENERGY=0.002
WAKE_ACCEPT_ENERGY=0.006
MWW_WINDOW=10
SILENCE_SEC=0.35

MUSIC_POLL=true
MUSIC_POLL_INTERVAL=3.0

# Bluetooth speaker (A2DP) + USB mic
# BT_DEVICE_MAC=AA:BB:CC:DD:EE:FF
BT_PROFILE=a2dp_sink
USB_MIC_VOLUME=100%
AUDIO_INPUT_DEVICE=pulse
# PULSE_DEFAULT_SOURCE=alsa_input.usb-C-Media_Electronics_Inc._USB_PnP_Sound_Device-00.analog-mono
BT_KEEPALIVE_SEC=120
BT_KEEPALIVE_VOL=1200
NOISE_SUPPRESS=true
NOISE_HP_HZ=280
# BARGE_IN=true
# A2DP + USB mic: barge-in only if the voice is louder than speaker bleed.
# BARGE_ENERGY_MULT=1.12
# MPV_COMMAND=mpv
